<%- include('../partials/page-hero', {
  heading: 'Selected Projects',
  intro: 'A visual record of telecom power systems, solar installations, civil works and site-build activities delivered by WetomTech.'
}) %>

<section class="section projects-page-section">
  <div class="container">
    <div class="project-filter reveal" role="group" aria-label="Filter projects">
      <button class="active" type="button" data-filter="all">All projects</button>
      <button type="button" data-filter="telecom">Telecom</button>
      <button type="button" data-filter="solar">Solar</button>
      <button type="button" data-filter="civil">Civil works</button>
      <button type="button" data-filter="site-build">Site build</button>
    </div>

    <div class="projects-masonry">
      <% site.projects.forEach((project, index) => { %>
        <article class="project-card reveal" data-category="<%= project.category %>" data-delay="<%= index * 60 %>">
          <button class="project-image-button" type="button" data-lightbox-src="<%= project.image %>" data-lightbox-title="<%= project.title %>">
            <img src="<%= project.image %>" alt="<%= project.title %>" loading="lazy" />
            <span class="project-expand">View image</span>
          </button>
          <div class="project-card-content">
            <span><%= project.category.replace('-', ' ') %></span>
            <h2><%= project.title %></h2>
            <p><%= project.description %></p>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<dialog class="lightbox" data-lightbox>
  <button type="button" aria-label="Close image" data-lightbox-close>×</button>
  <img src="" alt="" data-lightbox-image />
  <p data-lightbox-caption></p>
</dialog>

<section class="section project-capability-section">
  <div class="container project-capability-grid">
    <div class="reveal"><p class="section-label light">Project capability</p><h2>From early site work to commissioning and maintenance.</h2></div>
    <div class="project-capability-list reveal" data-delay="100">
      <span>Site assessment</span><span>Planning and design</span><span>Civil works</span><span>Electrical installation</span><span>Equipment integration</span><span>Testing and commissioning</span><span>Preventive maintenance</span><span>Corrective support</span>
    </div>
  </div>
</section>

<section class="section closing-cta light-cta">
  <div class="container closing-cta-inner">
    <div><p class="section-label">Discuss a similar project</p><h2>Share your scope, location and target outcome with our technical team.</h2></div>
    <a class="button" href="/contact">Request a quotation</a>
  </div>
</section>
