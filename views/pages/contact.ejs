<%- include('../partials/page-hero', {
  heading: 'Contact WetomTech',
  intro: 'Speak with the team about fiber internet, telecom infrastructure, renewable energy, civil works or technical support.'
}) %>

<section class="section contact-section">
  <div class="container contact-grid">
    <div class="contact-details reveal">
      <p class="section-label">Get in touch</p>
      <h2>Tell us what needs to work better.</h2>
      <p>
        Provide the service, location and a short description of the requirement. The team will review your request and contact you using the details supplied.
      </p>
      <div class="contact-cards">
        <a href="tel:<%= formatPhone(site.phones[0]) %>"><span>Phone</span><strong><%= site.phones.join(' / ') %></strong></a>
        <a href="mailto:<%= site.email %>"><span>Email</span><strong><%= site.email %></strong></a>
        <div><span>Office</span><strong><%= site.address %></strong></div>
        <div><span>Registration</span><strong><%= site.registration %></strong></div>
      </div>
      <a class="button button-whatsapp" href="https://wa.me/<%= site.whatsapp %>" target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
    </div>

    <div class="form-panel reveal" data-delay="100">
      <%- include('../partials/form-status') %>
      <form action="/contact" method="post">
        <input type="hidden" name="type" value="contact" />
        <div class="honeypot" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <div class="form-grid">
          <label>Full name<input type="text" name="fullName" required maxlength="120" /></label>
          <label>Organisation<input type="text" name="organisation" maxlength="160" /></label>
          <label>Email address<input type="email" name="email" required maxlength="160" /></label>
          <label>Phone number<input type="tel" name="phone" required maxlength="40" /></label>
          <label class="field-full">Service of interest
            <select name="service">
              <option value="">Select a service</option>
              <% site.services.forEach((service) => { %><option value="<%= service.title %>"><%= service.title %></option><% }) %>
              <option value="General enquiry">General enquiry</option>
            </select>
          </label>
          <label class="field-full">Project location or address<input type="text" name="address" maxlength="1000" /></label>
          <label class="field-full">How can we help?<textarea name="message" rows="6" required maxlength="3000"></textarea></label>
          <button class="button field-full" type="submit">Send enquiry</button>
        </div>
      </form>
    </div>
  </div>
</section>

<section class="section contact-map-section">
  <div class="container contact-map-card">
    <div><p class="section-label light">Visit the office</p><h2>Extension B_31, Efab Mall, Area 11, Garki, Abuja.</h2><p>Contact the team before visiting so the appropriate technical or commercial representative can attend to you.</p></div>
    <a class="button button-light" href="https://www.google.com/maps/search/?api=1&query=Efab+Mall+Area+11+Garki+Abuja" target="_blank" rel="noopener noreferrer">Open map</a>
  </div>
</section>
