<section class="hero">
  <div class="hero-orbit hero-orbit-one"></div>
  <div class="hero-orbit hero-orbit-two"></div>
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <p class="hero-label">High-speed fiber internet and engineering solutions</p>
      <h1>Connecting people.<br />Powering possibilities.</h1>
      <p class="hero-intro">
        <%= site.companyName %> delivers fiber internet deployment, telecom infrastructure, renewable energy and engineering services for organisations that need dependable performance.
      </p>
      <div class="hero-actions">
        <a class="button" href="/services">Explore our services</a>
        <a class="button button-outline" href="/contact">Request a site survey</a>
      </div>
      <div class="hero-proof">
        <div>
          <span>01</span>
          <strong>Field-led delivery</strong>
          <small>Technical teams focused on real site conditions.</small>
        </div>
        <div>
          <span>02</span>
          <strong>Multi-sector capability</strong>
          <small>Solutions for telecoms, energy, property and institutions.</small>
        </div>
        <div>
          <span>03</span>
          <strong>Safety-first execution</strong>
          <small>Quality, environment, health and safety built into operations.</small>
        </div>
      </div>
    </div>

    <div class="hero-visual reveal" data-delay="120">
      <div class="hero-image-wrap">
        <img src="/images/hero-tower.jpg" alt="Telecommunications tower representing WetomTech infrastructure services" />
        <div class="hero-image-lines"></div>
      </div>
      <div class="hero-floating-card coverage-card">
        <span>Service assessment</span>
        <strong>Check your location</strong>
        <a href="/coverage">Start coverage request</a>
      </div>
      <div class="hero-floating-card registration-card">
        <span>Company duely Registered</span>
        <!-- <strong><%= site.registration %></strong> -->
      </div>
    </div>
  </div>
  <div class="hero-bottom-wave"></div>
</section>

<section class="sector-strip" aria-label="Sectors served">
  <div class="container sector-strip-inner">
    <span>Industries we serve</span>
    <div class="sector-marquee">
      <div class="sector-marquee-track">
        <% [...site.sectors, ...site.sectors].forEach((sector) => { %>
          <strong><%= sector %></strong><i></i>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<section class="section section-about-home">
  <div class="container about-home-grid">
    <div class="about-home-copy reveal">
      <p class="section-label">About WetomTech</p>
      <h2>Engineering confidence into every connection.</h2>
      <p class="section-lead">
        We combine professional manpower, field experience and client-focused planning to deliver solutions that remain reliable beyond installation.
      </p>
      <p>
        Our work spans fiber internet, telecom infrastructure, solar power, construction management, civil works, equipment integration and technical maintenance. Every assignment is approached as a long-term operational asset, not a one-off installation.
      </p>
      <div class="about-home-actions">
        <a class="text-link" href="/about">Learn more about the company <span>→</span></a>
        <a class="text-link muted" href="/company-profile">Download profile <span>↓</span></a>
      </div>
    </div>

    <div class="principle-grid reveal" data-delay="100">
      <article class="principle-card principle-card-featured">
        <div class="principle-icon"><%- include('../partials/icon', { icon: 'shield' }) %></div>
        <h3>Our commitment</h3>
        <p><%= site.commitment %></p>
      </article>
      <article class="principle-card">
        <span class="principle-number">M</span>
        <h3>Mission</h3>
        <p><%= site.mission %></p>
      </article>
      <article class="principle-card">
        <span class="principle-number">V</span>
        <h3>Vision</h3>
        <p><%= site.vision %></p>
      </article>
    </div>
  </div>
</section>

<section class="section services-home">
  <div class="container">
    <div class="section-heading split-heading reveal">
      <div>
        <p class="section-label">What we do</p>
        <h2>Integrated technology and engineering services.</h2>
      </div>
      <p>
        From connectivity to power and physical infrastructure, WetomTech coordinates the technical disciplines required to move a project from assessment to dependable operation.
      </p>
    </div>

    <div class="service-showcase">
      <% site.services.forEach((service, index) => { %>
        <article class="service-showcase-card reveal" data-delay="<%= index * 70 %>" id="home-<%= service.slug %>">
          <div class="service-showcase-image">
            <img src="<%= service.image %>" alt="<%= service.title %>" loading="lazy" />
            <span><%= String(index + 1).padStart(2, '0') %></span>
          </div>
          <div class="service-showcase-content">
            <div class="service-icon"><%- include('../partials/icon', { icon: service.icon }) %></div>
            <h3><%= service.title %></h3>
            <p><%= service.summary %></p>
            <a href="/services#<%= service.slug %>">View capability <span>→</span></a>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section process-section">
  <div class="container process-grid">
    <div class="process-copy reveal">
      <p class="section-label light">How we work</p>
      <h2>A disciplined path from need to operation.</h2>
      <p>
        Our delivery model is designed to reduce uncertainty, identify site constraints early and give clients a clear technical route to completion.
      </p>
      <a class="button button-light" href="/contact">Discuss your project</a>
    </div>

    <ol class="process-list reveal" data-delay="120">
      <li>
        <span>01</span>
        <div><strong>Discover</strong><p>Understand the operational need, location, users and expected performance.</p></div>
      </li>
      <li>
        <span>02</span>
        <div><strong>Assess</strong><p>Conduct technical review, site survey, risk evaluation and solution planning.</p></div>
      </li>
      <li>
        <span>03</span>
        <div><strong>Deploy</strong><p>Execute civil, electrical, network and equipment installation with quality controls.</p></div>
      </li>
      <li>
        <span>04</span>
        <div><strong>Support</strong><p>Test, commission, document, maintain and improve the deployed solution.</p></div>
      </li>
    </ol>
  </div>
</section>

<section class="section projects-home">
  <div class="container">
    <div class="section-heading split-heading reveal">
      <div>
        <p class="section-label">Selected work</p>
        <h2>Projects delivered across power, connectivity and site infrastructure.</h2>
      </div>
      <a class="text-link" href="/projects">View all projects <span>→</span></a>
    </div>

    <div class="project-feature-grid">
      <% site.projects.slice(0, 3).forEach((project, index) => { %>
        <article class="project-feature-card <%= index === 0 ? 'project-feature-large' : '' %> reveal" data-delay="<%= index * 80 %>">
          <img src="<%= project.image %>" alt="<%= project.title %>" loading="lazy" />
          <div class="project-feature-overlay">
            <span><%= project.category.replace('-', ' ') %></span>
            <h3><%= project.title %></h3>
            <p><%= project.description %></p>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section assurance-section">
  <div class="container assurance-grid">
    <div class="assurance-image reveal">
      <img src="/images/solar-installation.jpg" alt="WetomTech technical team carrying out a solar installation" loading="lazy" />
      <div class="assurance-image-note">Safety is not an accident. It is a working discipline.</div>
    </div>
    <div class="assurance-copy reveal" data-delay="100">
      <p class="section-label">Quality, health and safety</p>
      <h2>Performance matters. So does the way it is achieved.</h2>
      <p>
        WetomTech places client satisfaction, regulatory compliance, risk control and environmental responsibility at the centre of project execution.
      </p>
      <div class="assurance-points">
        <div><strong>Quality management</strong><span>Defined responsibilities, inspections, testing and continuous improvement.</span></div>
        <div><strong>Health and safety</strong><span>Planning, training, appropriate tools and safe work procedures for field teams.</span></div>
        <div><strong>Environmental care</strong><span>Responsible site practices designed to protect people, communities and surroundings.</span></div>
      </div>
      <a class="text-link" href="/quality-safety">Read our approach <span>→</span></a>
    </div>
  </div>
</section>

<section class="section coverage-cta-section">
  <div class="container coverage-cta">
    <div class="coverage-cta-copy reveal">
      <p class="section-label light">Start with your location</p>
      <h2>Request a fiber coverage review or technical site assessment.</h2>
      <p>
        Tell us where the project is located and the service you need. Our team will review the details and contact you with the next step.
      </p>
    </div>
    <form class="coverage-mini-form reveal" data-delay="100" action="/coverage" method="post">
      <input type="hidden" name="type" value="coverage" />
      <div class="honeypot" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
      <label>Full name<input type="text" name="fullName" required maxlength="120" /></label>
      <label>Phone number<input type="tel" name="phone" required maxlength="40" /></label>
      <label>Email address<input type="email" name="email" required maxlength="160" /></label>
      <label>Service needed
        <select name="service" required>
          <option value="">Select a service</option>
          <% site.services.forEach((service) => { %><option value="<%= service.title %>"><%= service.shortTitle %></option><% }) %>
        </select>
      </label>
      <label class="field-full">Project address<input type="text" name="address" required maxlength="1000" /></label>
      <label class="field-full">Brief description<textarea name="message" rows="3" required maxlength="3000" placeholder="Tell us about the location, number of users, site type or expected output."></textarea></label>
      <button class="button button-light field-full" type="submit">Submit assessment request</button>
    </form>
  </div>
</section>

<section class="section faq-section">
  <div class="container faq-grid">
    <div class="faq-heading reveal">
      <p class="section-label">Frequently asked questions</p>
      <h2>Clear answers before the first site visit.</h2>
      <p>Need something more specific? Contact the WetomTech team directly.</p>
      <a class="text-link" href="/contact">Contact us <span>→</span></a>
    </div>
    <div class="faq-list reveal" data-delay="100">
      <% site.faqs.forEach((faq, index) => { %>
        <article class="faq-item <%= index === 0 ? 'open' : '' %>">
          <button type="button" aria-expanded="<%= index === 0 ? 'true' : 'false' %>">
            <span><%= faq.question %></span><i></i>
          </button>
          <div class="faq-answer"><p><%= faq.answer %></p></div>
        </article>
      <% }) %>
    </div>
  </div>
</section>