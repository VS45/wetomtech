<section class="section wetomnet-payment-section" id="subscribe">
  <div class="container wetomnet-payment-shell">
    <div class="wetomnet-payment-copy reveal">
      <p class="section-label light">Secure online payment</p>
      <h2>Subscribe and continue to OPay checkout.</h2>
      <p>
        Enter your details below. You will be redirected to OPay's secure hosted payment page to complete your ₦20,000 monthly subscription payment.
      </p>
      <div class="wetomnet-payment-trust">
        <div><strong>₦20,000</strong><span>Monthly plan</span></div>
        <div><strong>NGN</strong><span>Secure checkout</span></div>
        <div><strong>OPay</strong><span>Payment gateway</span></div>
      </div>
    </div>

    <form class="wetomnet-payment-form reveal" data-delay="100" action="/payments/opay/initialize" method="post">
      <input type="hidden" name="plan" value="wetomnet-unlimited-20k" />
      <div class="honeypot" aria-hidden="true">
        <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>

      <label>
        Full name
        <input type="text" name="fullName" required maxlength="120" autocomplete="name" placeholder="Enter your full name" />
      </label>

      <label>
        Email address
        <input type="email" name="email" required maxlength="160" autocomplete="email" placeholder="you@example.com" />
      </label>

      <label>
        Phone number
        <input type="tel" name="phone" required maxlength="20" autocomplete="tel" placeholder="0800 000 0000" />
      </label>

      <label>
        Service address
        <input type="text" name="address" required maxlength="500" autocomplete="street-address" placeholder="Enter the installation address" />
      </label>

      <label class="wetomnet-payment-consent">
        <input type="checkbox" name="termsAccepted" value="yes" required />
        <span>I confirm that my location is subject to coverage and installation assessment.</span>
      </label>

      <button class="button button-light wetomnet-pay-button" type="submit">
        Pay ₦20,000 securely with OPay
      </button>
      <small>Your payment is processed on OPay's hosted checkout. WetomTech does not collect your card or wallet PIN on this page.</small>
    </form>
  </div>
</section>

<section class="section faq-section wetomnet-faq-section">
  <div class="container faq-grid">
    <div class="faq-heading reveal">
      <p class="section-label">WetomNet questions</p>
      <h2>What to know before subscribing.</h2>
      <p>Coverage, installation conditions and connection technology may vary by location.</p>
