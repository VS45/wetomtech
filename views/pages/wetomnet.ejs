<!-- Inline Payment Handler Script -->
<!-- Inline Payment Handler Script -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
  const paymentForm = document.getElementById("flutterwavePaymentForm");
  
  if (paymentForm) {
    paymentForm.addEventListener("submit", makePayment);
  }
});
function makePayment(e) {
  e.preventDefault();

  // Basic anti-bot honeypot check
  if (document.getElementById("website").value !== "") return;

  const submitBtn = e.target.querySelector('button[type="submit"]');
  submitBtn.disabled = true;
  submitBtn.textContent = "Opening payment gateway...";

  const fullName = document.getElementById("fullName").value;
  const email = document.getElementById("email").value;
  const phone = document.getElementById("phone").value;
  const address = document.getElementById("address").value;

  // Generate dynamic, unique transaction reference
  const txRef = "WNET-" + Date.now() + "-" + Math.floor(Math.random() * 1000);

  FlutterwaveCheckout({
    public_key: "FLWPUBK-135145a53aa6d21c3b08c61793d2da85-X", // Replace with your actual Flutterwave Public Key
    tx_ref: txRef,
    amount: 20000,
    currency: "NGN",
    payment_options: "card,banktransfer,ussd",
    customer: {
      email: email,
      phone_number: phone,
      name: fullName,
    },
    meta: {
      service_address: address,
      plan: "wetomnet-unlimited-20k"
    },
    customizations: {
      title: "WetomNet Internet Subscription",
      description: "Payment for WetomNet ₦20,000 Unlimited Monthly Plan",
      logo: "https://wetomtech.com/images/wetom-logo.png" // MUST be a full absolute URL
    },
    callback: function (data) {
      // Send transaction payload to server for backend verification
      fetch("/payments/flutterwave/verify", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          transaction_id: data.transaction_id,
          tx_ref: data.tx_ref,
          status: data.status
        })
      })
      .then(res => res.json())
      .then(resData => {
        if (resData.success) {
          window.location.href = "/payments/success";
        } else {
          alert("Payment verification failed. Please contact support.");
          submitBtn.disabled = false;
          submitBtn.innerHTML = 'Pay ₦20,000 securely with Flutterwave <span>→</span>';
        }
      })
      .catch(err => {
        console.error("Verification error:", err);
        alert("An error occurred verifying your payment.");
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'Pay ₦20,000 securely with Flutterwave <span>→</span>';
      });
    },
    onclose: function() {
      // Re-enable button if user cancels or closes modal without completing payment
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Pay ₦20,000 securely with Flutterwave <span>→</span>';
    }
  });
}
</script>