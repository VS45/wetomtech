<div class="topbar">
  <div class="container topbar-inner">
    <div class="topbar-contact">
      <a href="tel:<%= formatPhone(site.phones[0]) %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.7 3.8.7.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.8 21 3 13.2 3 3.7c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.7 3.8.1.4.1.8-.2 1.1l-2.4 2.2Z"/></svg>
        <span><%= site.phones.join(', ') %></span>
      </a>
      <a href="mailto:<%= site.email %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h16a2 2 0 0 0 2-2V6c0-1.1-.9-2-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"/></svg>
        <span><%= site.email %></span>
      </a>
    </div>
    <span class="topbar-location"><%= site.address %></span>
  </div>
</div>
