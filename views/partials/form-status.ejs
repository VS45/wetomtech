<% if (formStatus === 'success') { %>
  <div class="form-alert success" role="status">Thank you. Your request has been received and the WetomTech team will contact you.</div>
<% } else if (formStatus === 'invalid') { %>
  <div class="form-alert error" role="alert">Please check the form and provide valid contact details and a clear message.</div>
<% } %>
